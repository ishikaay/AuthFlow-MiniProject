<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="w-full min-h-screen bg-zinc-900 text-white p-10">
        <div class="flex justify-end w-full">
            <a class="bg-red-500 rounded-md px-3 py-2 text-sm mb-5 inline-block" href="/logout">Logout</a>
        </div>
        <h5 class="mb-5">Edit your post.</h5>
        <form action="/update/<%= post._id%>" method="Post">
            <textarea class=" block p-3 outline-none w-1/3 resize-none bg-transparent border-2 border-zinc-800 rounded-md"  placeholder="Whats on your mind ? " name="content"><%= post.content%></textarea>
            <input class="px-3 py-2 bg-yellow-500 block rounded-md mt-2 w-52 text-sm" type="submit" value= "update post">
        </form>
    </div>
</body>
</html>